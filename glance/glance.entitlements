<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Upstream also declared keychain-access-groups. That entitlement only matters for sharing
	     keychain items between apps of the same team, which this app does not do (KeychainManager
	     passes no kSecAttrAccessGroup), and requiring it forces a provisioning profile and a
	     registered device for every local build. Dropped so the fork builds and signs on its own. -->
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
