<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Upstream pointed SUFeedURL at https://tryglance.app/appcast.xml. Left in place, a local
	     build would offer to "update" itself to the official release and replace every fix in this
	     fork with the build that does not unlock. There is no feed for this fork, so Sparkle is
	     given nothing to check and automatic checks are switched off. -->
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<key>SUEnableInstallerLauncherService</key>
	<false/>

	<!-- `open sesame://settings`. One of the three ways into Settings that replace the menu bar
	     item, and the one that scripts, Shortcuts and Raycast can drive. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.architsuryawanshi.sesame.settings</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sesame</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
